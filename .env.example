# =========================================================
# 1. VARIABLES PRINCIPALES (OBLIGATOIRES POUR LE BOT TELEGRAM)
# =========================================================
TELEGRAM_TOKEN=
# Identifiant Telegram numérique de l'administrateur (ex: 123456789, obtenu via /myid — jamais un @username)
ADMIN_ID=123456789
DATABASE_URL=

# =========================================================
# 2. AUTHENTIFICATION WEB, ADMIN UNIQUE & GOOGLE OAUTH 2.0
# =========================================================
# Définissez ADMIN_EMAIL (et ADMIN_INITIAL_PASSWORD si connexion par mot de passe)
# pour initialiser explicitement l'unique compte administrateur Web au démarrage.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
SESSION_SECRET=

# Google OAuth 2.0 (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=https://bitsure-production.up.railway.app

# Quotas par défaut par utilisateur Web
DEFAULT_DAILY_ANALYSIS_LIMIT=15
DEFAULT_DAILY_SCAN_LIMIT=10
DEFAULT_MAX_ALERTS_LIMIT=10
DEFAULT_MAX_PAPER_TRADES_LIMIT=25

# =========================================================
# 3. VARIABLES OPTIONNELLES (DONNÉES DE MARCHÉ, PAIEMENTS & IA LOGS)
# =========================================================
TWELVEDATA_API_KEY=
BINANCE_ID=
GEMINI_API_KEY=
GEMINI_LOG_MODEL=gemini-3.1-flash-lite
WEBHOOK_URL=
PORT=8443
PYTHON_API_PORT=8001

# =========================================================
# 3. CLÉS BINANCE TESTNET PAR DÉFAUT & SÉCURITÉ (OPTIONNEL)
# =========================================================
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
BINANCE_SPOT_TESTNET_API_KEY=
BINANCE_SPOT_TESTNET_API_SECRET=
SECURITY_CODE_MAX_ATTEMPTS=5
SECURITY_CODE_LOCK_SECONDS=900

# =========================================================
# 4. EMAILS TRANSACTIONNELS (RESEND) — MOT DE PASSE OUBLIÉ
# =========================================================
# Sans RESEND_API_KEY + EMAIL_FROM, « Mot de passe oublié » répond honnêtement « indisponible » (aucun faux envoi).
# APP_URL (section 2) sert à construire le lien /reset-password?token=...
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
# Politique de sessions et de réinitialisation (valeurs par défaut indiquées)
PASSWORD_RESET_TTL_MINUTES=30
PERSONAL_SESSION_DAYS=7
PUBLIC_SESSION_MAX_HOURS=12
PUBLIC_IDLE_TIMEOUT_MINUTES=30
